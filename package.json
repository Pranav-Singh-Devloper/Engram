{
  "name": "engram",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @engram/scripts migrate",
    "db:migrate:hosted": "pnpm --filter @engram/scripts migrate --hosted",
    "db:reset": "pnpm --filter @engram/scripts migrate --reset",
    "gemini:check": "pnpm --filter @engram/scripts gemini:check",
    "fixtures:record": "pnpm --filter @engram/scripts fixtures:record",
    "demo:offline": "pnpm --filter @engram/scripts demo:offline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
