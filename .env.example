# Copy to .env. Everything here is optional for local development:
# DATABASE_URL defaults to the docker compose database below.

# Local database (docker compose). If you change ENGRAM_DB_PORT, change the
# port in DATABASE_URL to match.
ENGRAM_DB_PORT=54329
DATABASE_URL=postgres://engram:engram@localhost:54329/engram

# Hosted Supabase database, used only by `pnpm db:migrate:hosted` and jobs.
# Use the session pooler or a direct connection, not the transaction pooler.
HOSTED_DATABASE_URL=

# Gemini (free tier, https://aistudio.google.com/apikey). Leave the key blank
# to stay offline: tests and `pnpm demo:offline` never need it.
# Free-tier inputs may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2
# Chosen in P02 from what `pnpm gemini:check` lists for your key.
GEMINI_CHAT_MODEL=

# Judge LLM for the bench (P04). Free tier: Groq.
JUDGE_PROVIDER=
JUDGE_API_KEY=

# MCP / HTTP API (P07, P09a).
ENGRAM_API_TOKEN=
ENGRAM_NAMESPACE=
