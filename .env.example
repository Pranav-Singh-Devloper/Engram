# Copy to .env. Everything here is optional for local development:
# DATABASE_URL defaults to the docker compose database below.

# Local database (docker compose). If you change ENGRAM_DB_PORT, change the
# port in DATABASE_URL to match.
ENGRAM_DB_PORT=54329
DATABASE_URL=postgres://engram:engram@localhost:54329/engram

# Hosted Neon database (ADR-014), used by `pnpm db:migrate:hosted` and the
# nightly jobs: the direct endpoint (host without "-pooler").
HOSTED_DATABASE_URL=
# Optional: Neon's pooled endpoint (PgBouncer). It resets each session's search
# path, so the app uses the direct endpoint unless P09a sets the path per
# transaction (SPEC §11).
HOSTED_POOLED_DATABASE_URL=

# Gemini (free tier, https://aistudio.google.com/apikey). Leave the key blank
# to stay offline: tests and `pnpm demo:offline` never need it.
# Free-tier inputs may be used by Google to improve its products.
GEMINI_API_KEY=
# Optional: keys from other accounts (comma-separated). Free quotas are per
# Google Cloud project, so a key from a different account adds a fresh daily
# quota; the provider switches to it when the main key's daily quota runs out.
GEMINI_API_KEY_FALLBACK=
GEMINI_EMBED_MODEL=gemini-embedding-2
# flash-lite is the model that stays usable on the free tier (ADR-005).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Judge LLM for the bench (P04). Free tier: Groq.
JUDGE_PROVIDER=
JUDGE_API_KEY=

# MCP (P07). stdio: the namespace this machine's MCP clients share
# (default "default").
ENGRAM_NAMESPACE=
# HTTP MCP at /api/mcp (P09a): comma-separated token:namespace pairs, each
# token at least 24 characters (e.g. `openssl rand -hex 24`).
ENGRAM_MCP_TOKENS=
# Bearer token for the REST endpoints (P09a).
ENGRAM_API_TOKEN=
